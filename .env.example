# URL backend NestJS (tanpa /api)
VITE_API_URL=http://localhost:4000
# URL publik folder upload bila disajikan Nginx/CDN terpisah (mis. https://files.umiraglobal.com/uploads)
# Kosong = <VITE_API_URL>/uploads
VITE_ASSET_URL=
# URL website Next.js — dipakai untuk preview gambar lama (/images/...) & tombol "Lihat di website"
VITE_SITE_URL=http://localhost:3005
